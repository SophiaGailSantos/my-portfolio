# Supabase project credentials.
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored, so your keys stay out of the repo.
#
# Where to find them: Supabase dashboard > your project > Settings > API
#
# The anon key is safe to ship in the browser. It is only safe because the
# contact_messages table has Row Level Security enabled and no policies, so
# the key cannot read or write anything. Never put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
